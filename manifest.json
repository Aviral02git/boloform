{
  "manifest_version": 3,
  "name": "BoloForm (Wispr voice form filling)",
  "version": "0.3.1",
  "description": "Wispr se boli hui details ko khule form ke sahi fields me bharta hai. Kuch submit nahi karta.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "BoloForm panel kholo (Alt+Shift+B)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "BoloForm panel kholo / band karo"
    }
  }
}
